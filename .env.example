# Django settings module (dev for local work; config.settings.prod in production).
DJANGO_SETTINGS_MODULE=config.settings.dev

# Required outside dev. Generate a long random value for production.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# Postgres container credentials (defaults are fine for local dev).
POSTGRES_DB=vazhithirivu
POSTGRES_USER=vazhithirivu
POSTGRES_PASSWORD=vazhithirivu

# PostGIS image tag (official images; amd64-only, emulated on Apple Silicon).
# Alternative supported tag: postgis/postgis:16-3.4
POSTGIS_IMAGE=postgis/postgis:17-3.5

# Host port the web app is published on.
WEB_PORT=8000

# DATABASE_URL is composed by docker compose for the web service.
# Only set it yourself when running outside compose, e.g.:
# DATABASE_URL=postgis://vazhithirivu:vazhithirivu@localhost:5432/vazhithirivu

# Google Maps Platform (the app boots without these; the map shows a
# "not configured" state until they are set).
# Browser key: used by the Maps JavaScript API, Places API (New) and
# Geocoding API (map-click destination labels) in the browser. It is public
# by design — restrict it by HTTP referrer and to those APIs in Google
# Cloud Console.
GOOGLE_MAPS_BROWSER_KEY=
# Map ID: create one under Maps Management / Map Styles in Cloud Console.
# Used for cloud-based styling and required for AdvancedMarkerElement.
GOOGLE_MAPS_MAP_ID=
# Server key: used for server-side Routes API calls (route planning).
# Enable the Routes API for this key; restrict it to the Routes API only,
# use NO referrer restriction (server-to-server), and add an IP restriction
# in production. Server-side only — never sent to the browser.
GOOGLE_MAPS_SERVER_KEY=

# Google sign-in (OAuth 2.0; optional — the button is hidden until both
# are set). Google Cloud Console → APIs & Services → Credentials →
# "OAuth client ID" of type "Web application", in the same project as the
# Maps keys. Authorized redirect URI:
#   http://localhost:8000/accounts/google/login/callback/
# (add your https:// origin in production). No extra APIs need enabling.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Outgoing mail (account self-service, e.g. password reset). Dev prints
# mail to the console; production needs a real SMTP backend/host.
#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Default map center/zoom (Kochi).
MAP_DEFAULT_LAT=9.9312
MAP_DEFAULT_LNG=76.2673
MAP_DEFAULT_ZOOM=13

# Map crossing endpoint bounds (defaults shown; see ADR-012).
#MAP_CROSSINGS_LIMIT=500
#MAP_BBOX_MAX_SPAN_DEG=1.5
#MAP_CROSSINGS_MIN_ZOOM=12

# Community crossing-report policy (defaults shown; see ADR-011).
#REPORT_FRESH_MINUTES=15
#REPORT_STALE_MINUTES=60
#REPORT_CONFLICT_WINDOW_MINUTES=5
#REPORT_DUPLICATE_WINDOW_MINUTES=2
#REPORT_MIN_FLIP_SECONDS=30
#REPORT_MAX_PER_HOUR=20
#REPORT_RETENTION_DAYS=30

# Realtime status pushes (defaults shown; see ADR-014). The Compose web
# service already sets REDIS_URL=redis://redis:6379/0; a blank value falls
# back to a per-process in-memory channel layer and cache (single-process
# servers only — fine for runserver).
#REDIS_URL=redis://redis:6379/0
#REALTIME_MAX_SUBSCRIPTIONS=500
#REALTIME_SUBSCRIBE_MIN_SECONDS=1.0

# Route planning (defaults shown; see ADR-013).
#ROUTING_PROVIDER=google
#ROUTING_TIMEOUT_SECONDS=8
# TRAFFIC_UNAWARE = Essentials SKU (default); TRAFFIC_AWARE = Pro SKU.
#ROUTING_GOOGLE_ROUTING_PREFERENCE=TRAFFIC_UNAWARE
#ROUTING_MAX_REQUESTS_PER_HOUR=60
#ROUTE_CROSSING_ON_ROUTE_M=20
#ROUTE_CROSSING_NEAR_M=50
#ROUTE_TRACK_MATCH_M=30
#ROUTE_AVOID_CLEARANCE_M=100
# Detour synthesis (see ADR-020): when a crossing blocks the route and
# Google offers no alternative, extra Routes calls through a via point
# offset from the crossing surface the side-road route. Each call counts
# against ROUTING_MAX_REQUESTS_PER_HOUR.
#ROUTE_DETOUR_ENABLED=1
#ROUTE_DETOUR_VIA_OFFSET_M=300
#ROUTE_DETOUR_MAX_CALLS=2

# Same-line crossing topology (see ADR-020): a live closed/open status
# propagates to up to RAILWAY_LINK_MAX_NEIGHBORS consecutive crossings
# along the same rail line, shown as "Likely closed/open (same line)" —
# inferred, never a direct report. Links are rebuilt by
# `manage.py link_crossings` (also runs at the end of each OSM import).
#RAILWAY_LINK_MAX_NEIGHBORS=3
#RAILWAY_LINK_SNAP_M=30
#RAILWAY_LINK_MAX_DISTANCE_M=15000

# Optional simulator (defaults shown; see ADR-015 + RUNBOOK "Simulation").
# Nothing runs until `manage.py simulator start` or the
# `docker compose --profile simulation` service drives a run.
# Simulated users are static (ADR-021): each one parks near a crossing
# and never moves — vehicle counts/speeds no longer apply.
#SIM_TICK_SECONDS=5
#SIM_DEFAULT_VEHICLES=60
#SIM_MAX_VEHICLES=200
#SIM_DEFAULT_DURATION_SECONDS=600
#SIM_PATH_LENGTH_M=4000
#SIM_HEARTBEAT_STALE_SECONDS=45
# Presence inference: simulated users parked within SIM_DWELL_RADIUS_M of
# a closed gate for SIM_DWELL_SECONDS raise a confirmation prompt in the
# web app; the crossing only gains a simulated status once a user clicks
# "Confirm gate closed" (see ADR-018). Seconds are demo-compressed.
# Queue gap/spacing place the parked users on the approaches.
#SIM_DWELL_RADIUS_M=20
#SIM_DWELL_SECONDS=20
#SIM_DWELL_MIN_USERS=1
#SIM_PROMPT_TTL_SECONDS=180
#SIM_QUEUE_GAP_M=7
#SIM_QUEUE_SPACING_M=8

# Journey / navigation sessions (defaults shown; see ADR-017).
# Position checks run only inside an opt-in session and are never stored.
#NAV_ALERT_RADIUS_M=300
#NAV_NEARBY_RADIUS_M=600
#NAV_NEARBY_LIMIT=50
#NAV_MIN_UPDATE_SECONDS=10
#NAV_MIN_UPDATE_DISTANCE_M=25
#NAV_SESSION_MAX_HOURS=6
#NAV_MAX_SESSIONS_PER_HOUR=30
#NAV_SESSION_RETENTION_DAYS=7
